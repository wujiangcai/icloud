# Copy to a private environment file; do not commit real values.
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=8766
PLATFORM_PUBLIC_ORIGIN=http://127.0.0.1:8766
PLATFORM_DATA_DIR=./data/platform
# Optional owner-console key. If blank, data/platform/platform_admin.key is generated.
PLATFORM_ADMIN_KEY=

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLATFORM_MASTER_KEY=replace-with-a-generated-fernet-key
PLATFORM_SESSION_TTL_SECONDS=86400
PLATFORM_CODE_MAX_AGE_SECONDS=3600
PLATFORM_IMAP_LOOKBACK_DAYS=3
PLATFORM_IMAP_RECENT_LIMIT=200
PLATFORM_IMAP_TIMEOUT_SECONDS=30
PLATFORM_WORKER_INTERVAL_SECONDS=30

# Comma-separated exact origins. Leave empty for same-origin/local use.
PLATFORM_CORS_ORIGINS=

# Optional private object storage for raw MIME archives. Keep empty until new R2 credentials are available.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_PREFIX=icloud-mail
R2_REQUIRED=false
# Local safety ceiling below the 10 GB / 1M free-tier limits.
R2_ARCHIVE_ENABLED=true
R2_MONTHLY_MAX_PUTS=900000
R2_MONTHLY_MAX_BYTES=9000000000
R2_MAX_OBJECT_BYTES=5242880
