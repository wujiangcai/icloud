R2_MONITOR_BUCKETS=icloud-code-platform-archives,icloud-code-platform-backups
ICLOUD_CODE_APP_ROOT=/home/ubuntu/icloud/icloud-code-api
ICLOUD_CODE_PROJECT_ENV=/home/ubuntu/icloud/icloud-code-api/.env.platform
R2_MONITOR_OUTPUT=/home/ubuntu/icloud/icloud-code-api/data/platform/r2-monitor.json
R2_FREE_STORAGE_BYTES=10000000000
R2_WARNING_STORAGE_BYTES=7000000000
R2_HARD_STORAGE_BYTES=8000000000
R2_FREE_CLASS_A=1000000
R2_WARNING_CLASS_A=800000
R2_HARD_CLASS_A=900000
R2_FREE_CLASS_B=10000000
R2_WARNING_CLASS_B=8000000
R2_HARD_CLASS_B=9000000
