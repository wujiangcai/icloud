AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
AWS_DEFAULT_REGION=auto
AWS_REGION=auto
R2_REPOSITORY=s3:https://ACCOUNT_ID.r2.cloudflarestorage.com/BUCKET_NAME/restic
LOCAL_REPOSITORY=/var/backups/icloud-code-platform/restic
RESTIC_PASSWORD_FILE=/etc/icloud-code-platform/restic-password
RESTIC_CACHE_DIR=/var/cache/icloud-code-platform-restic
